{
    "version": "7.6.2",
    "private": true,
    "main": "main/index.js",
    "name": "LifeManager",
    "author": "vbetsch",
    "description": "Life Manager",
    "productName": "LifeManager",
    "scripts": {
        "clean": "rimraf dist main renderer/out renderer/.next",
        "dev": "npm run build:electron && electron .",
        "build:renderer": "next build src",
        "build:electron": "tsc -p electron",
        "build:all": "npm run build:renderer && npm run build:electron",
        "pack-app": "npm run build:all && electron-builder --dir",
        "dist": "npm run build:all && electron-builder",
        "build": "npm run dist && ./scripts/build-tarball.sh",
        "type-check": "tsc -p ./src/tsconfig.json && tsc -p ./electron/tsconfig.json"
    },
    "dependencies": {
        "electron-is-dev": "^1.2.0",
        "electron-next": "^3.1.5",
        "react": "^18.2.0",
        "react-dom": "^18.2.0"
    },
    "devDependencies": {
        "@types/node": "^14.18.63",
        "@types/react": "^16.14.52",
        "@types/react-dom": "^16.9.24",
        "electron": "^27.1.2",
        "electron-builder": "^24.9.1",
        "next": "latest",
        "rimraf": "^3.0.2",
        "typescript": "^4.9.5"
    },
    "build": {
        "asar": true,
        "files": [
            "main",
            "src/out"
        ]
    }
}
